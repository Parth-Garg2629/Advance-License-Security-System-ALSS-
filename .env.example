# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-a-strong-random-key

# Database
DATABASE_URI=sqlite:///database/alss.db

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-generate-a-strong-random-key
JWT_ACCESS_TOKEN_EXPIRES=600
JWT_REFRESH_TOKEN_EXPIRES=1209600

# Encryption Key
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Admin Configuration (First-time setup only)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Application Settings
DEBUG=False
TESTING=False
